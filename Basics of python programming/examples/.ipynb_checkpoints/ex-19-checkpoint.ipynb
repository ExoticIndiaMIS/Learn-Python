   "source": [
    "# Wap to calculate area of the triangle using heron's formula"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cbe74842-46e1-45a8-b67b-ee359055c07c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the 1st side  12\n",
      "enter the 2nd side  18\n",
      "enter the 3rd side  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "area of triangle is = 56.568542494923804\n"
     ]
    }
   ],
   "source": [
    "a = float(input(\"enter the 1st side \"))\n",
    "b = float(input(\"enter the 2nd side \"))\n",
    "c = float(input(\"enter the 3rd side \"))\n",
    "s = (a+b+c)/2\n",
    "area = (s*(s-a)*(s-b)*(s-c))**0.5\n",
    "print(\"area of triangle is =\",area)\n",
    "\n",
    "    \n"
   ]
  },
