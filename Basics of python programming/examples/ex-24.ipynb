   "source": [
    "# Wap to print digit at one's place of a number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9c4e754b-ddc6-4b1d-b916-97b9b92cc7f6",
   "metadata": {},
   "outputs": [
