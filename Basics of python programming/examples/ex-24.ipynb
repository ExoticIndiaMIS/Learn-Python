     "output_type": "stream",
     "text": [
      "enter the number = 12345\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "one's place digit = 5\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"enter the number =\"))\n",
