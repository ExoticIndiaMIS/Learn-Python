   "source": [
    "# program to demonstrate name clash variable in case of nested function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1dce5cc6-afc9-4ca4-9280-443dccdc1c06",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "inner variable =  20\n",
      "outer variable= 10\n"
     ]
    }
   ],
   "source": [
    "def outer():\n",
    "    var = 10\n",
    "    def inner():\n",
    "        var1 = 20\n",
    "        print(\"inner variable = \",var1)\n",
    "    inner()\n",
    "    print(\"outer variable=\",var)\n",
    "outer()\n"
   ]
  },
