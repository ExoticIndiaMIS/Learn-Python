   "source": [
    "# program to find smaller of two number using lambda function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9f22d9e6-4f49-46cf-acf7-c836d2cba15d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Smaller number is: 10\n"
     ]
    }
   ],
   "source": [
    "smaller = lambda a, b: a if a < b else b\n",
    "\n",
    "# Example usage\n",
    "num1 = 10\n",
    "num2 = 20\n",
    "\n",
    "print(\"Smaller number is:\", smaller(num1, num2))\n"
   ]
  },
