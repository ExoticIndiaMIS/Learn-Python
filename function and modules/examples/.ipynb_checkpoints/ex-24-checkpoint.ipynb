   "source": [
    "# PROGRAM TO demonstrate the use of variable-length arguments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "1e5fd3f8-3d38-4886-a425-b1d19fc28a15",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " name navte\n",
      "math\n",
      "science\n",
      "hindi\n"
     ]
    }
   ],
   "source": [
    "def func(name,*sub):\n",
    "    print(\" name\",name)\n",
    "    for i in (sub):\n",
    "        print(i)\n",
    "func(\"navte\",\"math\",\"science\",\"hindi\")"
   ]
