   "source": [
    "# Wap to calculate the sum of number from m to n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "211ceed7-1e1e-4519-a21c-b3109a86bc42",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of m = 3\n",
      "enter the value of n = 9\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "42\n"
     ]
    }
   ],
   "source": [
    "m = int(input(\"enter the value of m =\"))\n",
    "n = int(input(\"enter the value of n =\"))\n",
    "\n",
    "sum =0\n",
    "while(m<=n):\n",
    "    sum = sum+m\n",
    "    m = m+1\n",
    "print(sum)"
   ]
