   "source": [
    "# Wap to sum the series - 1+1/2+1/3+...1/n."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7103727a-b20d-4ec3-9cb4-bb39aaf1ad77",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the number 10000\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of  1+1/2+1/3+...1/10000 is 9.787606036044348\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"enter the number\"))\n",
    "sum = 0.0\n",
    "for i  in range(1,num+1):\n",
    "    a = 1.0/i\n",
    "    sum = sum+a\n",
    "print(\"sum of  1+1/2+1/3+...1/\"+str(num)+\" is \"+str(sum))"
   ]
  },
