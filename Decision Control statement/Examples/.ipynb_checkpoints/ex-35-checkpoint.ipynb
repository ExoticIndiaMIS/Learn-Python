   "source": [
    "# Wap using for loop to calculate the average of first n number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "fb415cb6-ba31-4b6e-a690-a29c74bb299b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n= 10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of the numbers are = 55\n",
      "average of the numbers are= 5.5\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n=\"))\n",
    "avg = 0.0\n",
    "sum = 0\n",
    "for i in range(1,n+1):\n",
    "    sum = sum+i\n",
    "avg = sum/i\n",
    "print(\"sum of the numbers are =\",sum)\n",
    "print(\"average of the numbers are=\",avg)"
   ]
  },
