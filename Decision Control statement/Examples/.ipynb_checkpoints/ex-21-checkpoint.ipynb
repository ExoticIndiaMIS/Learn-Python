   "source": [
    "# Wap to calculate the sum and average of first 10 numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fd5677e9-4eac-4758-94d1-5ec90d5bef12",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sum = 55\n",
      "average= 5.5\n"
     ]
    }
   ],
   "source": [
    "i = 0\n",
    "s = 0\n",
    "while(i<=10):\n",
    "    s = s+i\n",
    "    i = i+1\n",
    "avg = s/10\n",
    "print(\"Sum =\",s)\n",
    "print(\"average=\",avg)"
   ]
  },
