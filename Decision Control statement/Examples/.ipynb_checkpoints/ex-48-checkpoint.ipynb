   "source": [
    "# Wap to sum of square of even numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "17647e71-062a-4873-948b-7506cdcd6ed7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n =  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of square of even numbers less than  10 is 220\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n = \"))\n",
    "sum = 0\n",
    "for i in range (1,n+1):\n",
    "    if (i%2==0):\n",
    "        term = i**2\n",
    "    else:\n",
    "        term =0\n",
    "    sum = sum+term\n",
    "print(\"sum of square of even numbers less than \",n,\"is\",sum)"
   ]
  },
