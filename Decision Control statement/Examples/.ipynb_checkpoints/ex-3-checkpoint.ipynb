     "text": [
      "entered character is space\n"
     ]
    }
   ],
   "source": [
    "char = input(\"Enter the character=\")\n",
    "if(char.isalpha()):\n",
    "    print(\"entered character is alphabate \")\n",
    "if(char.isdigit()):\n",
    "    print(\"entered character is digit\")\n",
    "if(char.isspace()):\n",
    "    print(\"entered character is space\")\n"
   ]
