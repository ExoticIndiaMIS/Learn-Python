   "source": [
    "# Wap to sum the series -- 1/2+2/3+3/4+.....n/(n+1)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "dae1636b-d9a5-4eac-8b25-960c2790e492",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n= 5\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of the series 1/2+2/3+3/4+.....5/6is3.5500000000000003\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n=\"))\n",
    "sum = 0.0\n",
    "for i in range(1,n+1):\n",
    "    a = float(i)/(i+1)\n",
    "    sum = sum +a\n",
    "print(\"sum of the series 1/2+2/3+3/4+.....\"+str(n)+\"/\"+str(n+1)+\"is\"+str(sum))"
   ]
  },
