     "output_type": "stream",
     "text": [
      "        1 \n",
      "      1 2 1 \n",
      "    1 2 3 2 1 \n",
      "  1 2 3 4 3 2 1 \n",
      "1 2 3 4 5 4 3 2 1 \n"
     ]
    }
   ],
   "source": [
    "n = 5 \n",
    "for i in range (1,n+1):\n",
    "    for k in range (n,i,-1):\n",
    "        print(\" \",end=\" \")\n",
    "    for j in range (1,i+1):\n",
    "        print(j,end=\" \")\n",
    "    for l in range (i-1,0,-1):\n",
    "        print(l,end=\" \")\n",
    "    print()"
   ]
