   "source": [
    "# Wap to sum the series -- 1/1**2+1/2**2+1/3**2....1/n**2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "4f2f1d5d-6417-4a6f-bd52-9290d931ee0e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n= 5\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of series 1/1**2+1/2**2+1/3**2....1/25 is 1.4636111111111112\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n=\"))\n",
    "sum = 0.0\n",
    "for i in range (1,n+1):\n",
    "    a = 1.0/(i**2)\n",
    "    sum = sum+a\n",
    "print(\"sum of series 1/1**2+1/2**2+1/3**2....1/\"+str(n**2)+\" is \"+str(sum))"
   ]
  },
