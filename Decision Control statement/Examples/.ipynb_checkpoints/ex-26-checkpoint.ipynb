     ]
    }
   ],
   "source": [
    "n= int(input(\"enter the number\"))\n",
    "sum =0\n",
    "num = n\n",
    "while(n>0):\n",
    "    r = n%10\n",
    "    sum = sum+(r**3)\n",
    "    n = n//10\n",
    "if (sum==num):\n",
    "    print(\"amstrong\")\n",
    "else:\n",
    "    print(\"not amstrong\")"
   ]
