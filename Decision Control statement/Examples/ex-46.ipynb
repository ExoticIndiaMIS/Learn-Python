   "source": [
    "# Wap to sum the series -- 1/1+2**2/2+3**2+.....n**n/n ."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "fff90e48-4f4e-4c1a-b11a-928ef1ecf4ae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n= 5\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of the series 1/1+2**2/2+3**2+.....3125/5 is 701.0\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n=\"))\n",
    "sum = 0.0\n",
    "for i in range(1,n+1):\n",
    "    a = float(i**i)/i\n",
    "    sum = sum+a\n",
    "print(\"sum of the series 1/1+2**2/2+3**2+.....\"+str(n**n)+\"/\"+str(n)+\" is \"+str(sum))"
   ]
  },
