   "source": [
    "# wap to enter a number and then calculate the sum of its digits."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "a122c14d-fd08-4870-ab8f-a64d987769c1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the number = 32\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum of the digits 5\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"enter the number =\"))\n",
    "sum = 0\n",
    "while(num!=0):\n",
    "    temp = num%10\n",
    "    sum = sum+temp\n",
    "    num = num//10\n",
    "print(\"sum of the digits\",sum)"
   ]
  },
