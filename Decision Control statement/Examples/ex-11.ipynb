   "source": [
    "# Wap to test whether a number entered by user is negative, positive,or equal to zero "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "403a0734-45fc-4cdb-b1ae-00176c9eb24c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the number = 0\n"
     ]
    },
    {
     "name": "stdout",
