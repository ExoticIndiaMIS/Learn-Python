     "text": [
      "entered number is zero \n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"enter the number =\"))\n",
    "if (num ==0):\n",
    "    print(\"entered number is zero \")\n",
    "elif(num>0):\n",
    "    print(\"entered number is positive \")\n",
    "else:\n",
    "    print(\"entered number is negative \")\n",
    "    "
