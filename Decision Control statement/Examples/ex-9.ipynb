   "source": [
    "# Wap to find the whether a given year is leap year or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "1275a9fd-4c5a-4f8e-95d5-ece5ac84460a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter the year to find leap year= 2000\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2000 year is leap year\n"
     ]
    }
   ],
   "source": [
    "year = int(input(\"Enter the year to find leap year=\"))\n",
    "if (year%4==0 and year%100!=0) or (year%400==0):\n",
    "    print(year,\"year is leap year\")\n",
    "else:\n",
    "    print(year,\"is not a leap year\")\n",
    "    \n",
    "          "
   ]
  },
