   "source": [
    "# Using a for loop , Write a program that prints out the decimal equivalent of 1/2,1/3,1/4 ....1/10"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b51c6410-b025-4a57-b794-1a9926a39b66",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1/ 1 =1.000000\n",
      "1/ 2 =0.500000\n",
      "1/ 3 =0.333333\n",
      "1/ 4 =0.250000\n",
      "1/ 5 =0.200000\n",
      "1/ 6 =0.166667\n",
      "1/ 7 =0.142857\n",
      "1/ 8 =0.125000\n",
      "1/ 9 =0.111111\n"
     ]
    }
   ],
   "source": [
    "for i in range (1,10):\n",
    "    print(\"1/\",i,\"=%f\"%(1.0/i))"
   ]
  },
