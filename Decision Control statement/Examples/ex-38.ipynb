   "source": [
    "# Wap using for loop to find factorial of a number."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "af8914ea-7870-4afb-89d9-8a84373b50fa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n = 5\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "factorial of a 5 is 120\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n =\"))\n",
    "if (n==0):\n",
    "    factorial = 1\n",
    "factorial = 1\n",
    "for i in range (1,n+1):\n",
    "    factorial = factorial*i\n",
    "print(\"factorial of a\",n,\"is\",factorial)\n",
    "    "
   ]
  },
