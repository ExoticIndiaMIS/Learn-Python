   "source": [
    "# Wap to enter a number. Calculate and display the binary equivalent of the number."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "045ea556-ea16-42cb-af53-f0a0e06cd610",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the digit numbe 32\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "binary number  =  100000\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"enter the digit numbe\"))\n",
    "bin = 0\n",
    "i = 0\n",
    "while(num !=0):\n",
    "    reminde = num%2\n",
    "    bin = bin+reminde*(10**i)\n",
    "    num = num//2\n",
    "    i = i+1\n",
    "print(\"binary number  = \",bin)"
   ]
  },
