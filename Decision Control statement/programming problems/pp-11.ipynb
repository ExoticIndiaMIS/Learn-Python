   "source": [
    "# Wap to sum the series 1^2/1+2^2/2+3^3/3....n^n/n."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "524e3fe1-7957-4f8d-9d8a-ee053e6e1fda",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the value of n 3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sum the series 1^2/1+2^2/2+3^3/3.... 3 ^ 3 / 3 is 6.0\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"enter the value of n\"))\n",
    "sum = 0\n",
    "for i in range(1,n+1):\n",
    "    sum = sum+(i**2/i)\n",
    "print(\"sum the series 1^2/1+2^2/2+3^3/3....\",n,\"^\",n,\"/\",n,\"is\",sum)"
   ]
  },
