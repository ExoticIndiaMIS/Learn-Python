   "source": [
    "# Wap that accept any numberand prints the number of digit in that number."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "2a093e9e-dbf4-4064-8773-6ab9cf35d7c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  55\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of digits: 2\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "num = abs(num)  \n",
    "count = 0\n",
    "if num == 0:\n",
    "    count = 1 \n",
    "else:\n",
    "    while num > 0:\n",
    "        num //= 10  \n",
    "        count += 1\n",
    "print(\"Number of digits:\", count)\n"
   ]
  },
