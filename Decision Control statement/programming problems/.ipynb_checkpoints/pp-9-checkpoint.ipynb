   "source": [
    "# Wap to find whether a given yesr is leap year or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3bb5699d-996c-494c-932a-9bfc9c828197",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "enter the year  2000\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "year is leap year\n"
     ]
    }
   ],
   "source": [
    "year = int(input(\"enter the year \"))\n",
    "if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):\n",
    "    print(\"year is leap year\")\n",
    "else:\n",
    "    print(\"year is not leap year\")"
   ]
  },
