   "source": [
    "# Wap to print the sum of all odd numbers from 1 to 100."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "242657fa-dc27-4a1c-b5a7-9402fae78165",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The sum of all odd number from 1 to 100 is 2500\n"
     ]
    }
   ],
   "source": [
    "sum = 0\n",
    "for i in range (1,100):\n",
    "    if i%2!= 0:\n",
    "        sum = sum+i\n",
    "print(f\"The sum of all odd number from 1 to 100 is {sum}\")\n",
    "    "
   ]
  },
