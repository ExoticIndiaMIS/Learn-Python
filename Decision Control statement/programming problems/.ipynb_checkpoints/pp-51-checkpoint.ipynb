   "source": [
    "# Wap a simple program that display the following power of 2 one per line 2^1,2^2,2^3,......"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6bda1532-5779-4678-a05d-1a37472f14cd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter the number of terms:  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2^1 = 2\n",
      "2^2 = 4\n",
      "2^3 = 8\n",
      "2^4 = 16\n",
      "2^5 = 32\n",
      "2^6 = 64\n",
      "2^7 = 128\n",
      "2^8 = 256\n",
      "2^9 = 512\n",
      "2^10 = 1024\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter the number of terms: \"))  \n",
    "\n",
    "for i in range(1, n + 1):  \n",
    "    print(f\"2^{i} = {2**i}\")  \n"
   ]
  },
