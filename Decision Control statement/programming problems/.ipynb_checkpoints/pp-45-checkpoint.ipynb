   "source": [
    "# Wap to print the sum of the following nth series."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8e2355c3-dd67-42ae-9c56-cd553c562b8e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter the number of terms (n):  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sum of the series: 220\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter the number of terms (n): \"))\n",
    "\n",
    "sum_series = 0  # Initialize sum\n",
    "\n",
    "for k in range(1, n+1):\n",
    "    sum_series += (k * (k + 1)) // 2  # Sum of first k natural numbers\n",
    "\n",
    "print(\"Sum of the series:\", sum_series)\n"
   ]
  },
