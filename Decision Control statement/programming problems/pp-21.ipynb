   "source": [
    "# Wap to test if the given number is a power of 2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "a7ad6498-ba27-420b-bf51-d3e72ba29b67",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "4 is a power of 2\n"
     ]
    }
   ],
   "source": [
    "x = int(input(\"Enter a number: \"))\n",
    "\n",
    "if x > 0 and (x & (x - 1)) == 0:\n",
    "    print(f\"{x} is a power of 2\")\n",
    "else:\n",
    "    print(f\"{x} is NOT a power of 2\")\n"
   ]
  },
