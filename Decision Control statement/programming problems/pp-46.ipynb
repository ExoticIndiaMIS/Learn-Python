   "source": [
    "# Wap to print the following pattern."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "58287128-fa4b-40b2-84d8-bdad7ae42ea9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "\n",
      "*\n",
      "**\n",
      "***\n",
      "****\n",
      "*****\n",
      "****\n",
      "***\n",
      "**\n",
      "*"
     ]
    }
   ],
   "source": [
    "for i in range (5):\n",
    "    print()\n",
    "    for j in range (i):\n",
    "        print(\"*\",end=\"\")\n",
    "for i in range (5,0,-1):\n",
    "    print()\n",
    "    for j in range (1,i+1):\n",
    "        print(\"*\",end=\"\")"
   ]
