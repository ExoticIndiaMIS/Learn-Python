   "source": [
    "n= int(input(\"enter the number\"))\n",
    "sum = 0\n",
    "avg = 0\n",
    "for i in range (1,n+1):\n",
    "    sum = sum+i\n",
    "    avg = sum/i\n",
    "print( f\"average of {n} natural number \",avg)"
