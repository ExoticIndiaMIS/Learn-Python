   "source": [
    "# Wap to display the sin(x) value where range from 0 to 360 in steps of 15."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3adbae76-7572-4007-9fb5-6ce79451d05e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "x (degrees)  sin(x)\n",
      "----------------------\n",
      "0            0.0\n",
      "15           0.2588\n",
      "30           0.5\n",
      "45           0.7071\n",
      "60           0.866\n",
      "75           0.9659\n",
      "90           1.0\n",
      "105          0.9659\n",
      "120          0.866\n",
      "135          0.7071\n",
      "150          0.5\n",
      "165          0.2588\n",
      "180          0.0\n",
      "195          -0.2588\n",
      "210          -0.5\n",
      "225          -0.7071\n",
      "240          -0.866\n",
      "255          -0.9659\n",
      "270          -1.0\n",
      "285          -0.9659\n",
      "300          -0.866\n",
      "315          -0.7071\n",
      "330          -0.5\n",
      "345          -0.2588\n",
      "360          -0.0\n"
     ]
    }
   ],
   "source": [
    "import math\n",
    "print(\"x (degrees)  sin(x)\")\n",
    "print(\"----------------------\")\n",
    "for x in range(0, 361, 15):  \n",
    "    sin_x = round(math.sin(math.radians(x)), 4)  \n",
    "    print(f\"{x:<12} {sin_x}\")\n"
   ]
  },
